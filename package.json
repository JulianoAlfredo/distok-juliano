{
  "name": "distok",
  "version": "1.0.0",
  "private": true,
  "description": "DISTOK — SaaS de gerenciamento de estoque para distribuidoras (multi-tenant)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "eslint .",
    "test": "npm run test -w apps/api",
    "migrate": "npm run migrate -w apps/api",
    "migrate:test": "npm run migrate:test -w apps/api",
    "seed": "npm run seed -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0"
  },
  "engines": {
    "node": ">=18"
  }
}
