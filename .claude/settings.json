{
  "statusLine": {
    "type": "command",
    "command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/statusline.js"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/sessao-inicio.js"],
            "statusMessage": "estado do distok",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/sessao-fim.js"],
            "statusMessage": "trava de memoria",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
