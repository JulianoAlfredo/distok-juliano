# ============================================================
# DISTOK — API (produção). Copie para `.env` NA RAIZ DO REPO
# (não em apps/api) — é o arquivo lido por apps/api/src/config/env.js.
#   cp .env.production.example .env
# ============================================================

NODE_ENV=production
PORT=3000

# URL pública onde o front (e a API, se estiverem no mesmo domínio) responde.
# Usada pelo CORS — precisa bater exatamente com a origem real, com https://.
APP_BASE_URL=https://painel.distok.com.br

# Domínio raiz, usado para identificar subdomínio de tenant (<slug>.ROOT_DOMAIN).
ROOT_DOMAIN=distok.com.br

# Gere com: openssl rand -hex 32
JWT_SECRET=

# ---------- Banco (MySQL) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ---------- E-mail (Resend — sem RESEND_API_KEY o sistema só loga e não envia) ----------
# Pegue em https://resend.com/api-keys. Precisa ter o domínio de MAIL_FROM verificado lá.
RESEND_API_KEY=
MAIL_FROM=SUPORTE DISTOK <suporte@distok.com.br>
# Migrado de SMTP/nodemailer pra Resend — MAIL_SMTP_* não é mais lido pelo app.

# ---------- Upload de logo/marca (branding) ----------
# UPLOADS_DIR: pasta em disco onde os arquivos ficam salvos (fora do webroot).
# UPLOADS_PUBLIC_URL: como esses arquivos são servidos publicamente (via /uploads).
UPLOADS_DIR=
UPLOADS_PUBLIC_URL=https://painel.distok.com.br/uploads

# ---------- Backup (scripts/backup-db.sh) ----------
BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
# Comando pra copiar o dump pra FORA deste servidor (rclone, scp, etc.) — sem
# isso o backup fica só local, o que não cumpre RPO em caso de problema no servidor.
BACKUP_OFFSITE_CMD=

# ---------- Alerting de erro (opcional) ----------
# Crie um projeto Node em sentry.io e cole o DSN aqui. Sem isso, o app roda
# normal e só loga localmente (comportamento de sempre).
SENTRY_DSN=

# ---------- Integração Zé Delivery ----------
# Chave AES-256-GCM (base64 de 32 bytes) p/ criptografar client_secret/tokens em repouso.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar essa chave invalida as credenciais já salvas de todos os tenants (precisam recadastrar).
ZE_DELIVERY_ENC_KEY=

# Segredo compartilhado dos endpoints internos de cron (/internal/ze-delivery/*).
# Gere com: openssl rand -hex 32
# Ver apps/api/src/modules/ze-delivery/README.md para como configurar o cron externo.
ZE_DELIVERY_CRON_SECRET=
