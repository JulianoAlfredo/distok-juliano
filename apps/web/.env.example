# ============================================================
# DISTOK — frontend (build do Vite)
# Copie para apps/web/.env (ou .env.production) ANTES de `npm run build`.
# ============================================================

# URL absoluta da API em produção. Use SE o front e a API estiverem em domínios
# diferentes (ex.: front em app.distok.com.br e API em api.distok.com.br).
#   VITE_API_URL=https://api.distok.com.br/api/v1
#
# DEIXE EM BRANCO (ou não defina) se a API for servida no MESMO domínio do front
# via proxy/.htaccess — nesse caso o front usa o caminho relativo /api/v1.
VITE_API_URL=
